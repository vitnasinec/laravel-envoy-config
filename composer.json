{
    "name": "vitnasinec/laravel-envoy-config",
    "description": "One Envoy setup for every project: a typed config block in your repo, every task in vendor.",
    "keywords": ["laravel", "envoy", "deploy", "ssh", "rsync"],
    "license": "MIT",
    "authors": [
        {
            "name": "vitnasinec",
            "email": "vitnasinec@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/envoy": "^2.8",
        "vlucas/phpdotenv": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Vitnasinec\\EnvoyConfig\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
