# =============================================================================
# Envoy — the only keys it reads from .env. Everything else is configured in
# the Config object at the top of Envoy.blade.php.
#
# Append these to the project's .env (this file is never read directly). The
# local database reuses Laravel's own DB_USERNAME / DB_PASSWORD, which are
# already there, so the remote's credentials are all there is to add.
# =============================================================================

PROD_DB_USERNAME=
PROD_DB_PASSWORD=
