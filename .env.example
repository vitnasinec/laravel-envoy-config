# =============================================================================
# Envoy — append to the project's .env (this file is never read directly).
# What each key does: README, "Env keys".
# =============================================================================

# --- Production --------------------------------------------------------------
PROD_SSH_HOST=example.pef.czu.cz
PROD_SSH_USER=exampleuser
PROD_SSH_PORT=22

PROD_PATH="~/code/stage1"
PROD_DUMP_PATH="~/code/temp"
PROD_BRANCH=main

PROD_PHP=php
PROD_COMPOSER=composer
PROD_NPM=npm

PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=3306
PROD_DB_DATABASE=
PROD_DB_USERNAME=
PROD_DB_PASSWORD=

# --- Development (optional) --------------------------------------------------
DEV_SSH_HOST=example-dev.pef.czu.cz
DEV_SSH_USER=exampledevuser
DEV_SSH_PORT=22

DEV_PATH="~/code/stage1"
DEV_DUMP_PATH="~/code/temp"
DEV_BRANCH=dev

DEV_PHP=php
DEV_COMPOSER=composer
DEV_NPM=npm

DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=3306
DEV_DB_DATABASE=
DEV_DB_USERNAME=
DEV_DB_PASSWORD=

# --- Envoy behaviour ---------------------------------------------------------
ENVOY_DUMP_PATH="./storage/envoy"
ENVOY_BUILD_ASSETS=true

# Which directories THIS project mirrors, and which way. Nothing else is touched.
ENVOY_STORAGE_SYNC="storage-pull --dir=storage/app"

ENVOY_DB_IGNORE_TABLES=migrations,cache,cache_locks,sessions,jobs,job_batches,failed_jobs,telescope_entries,telescope_entries_tags,telescope_monitoring,pulse_aggregates,pulse_entries,pulse_values
ENVOY_DB_DUMP_SCHEMA=false

# SQLite projects only, and only if the file is not at database/database.sqlite:
# PROD_DB_SQLITE_PATH="~/site.cz/database/database.sqlite"
